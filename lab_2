#include <stdio.h>
#include <math.h>
#include <locale.h>

int cnt = 1;// заводим счетчик, причем он равен 1 так как есть минимум подпоследовательность в ненулевом массиве, состоящая из 1 элемента/ 1 максимального элемента
int mx = -10000000000;

int max_(int a, int b){
    return a >= b ? a : b;
} // создание функции нахожднния максимума из 2 чисел

int pp(int arr[], int n){
    if (n == 0){
        return 0;
    }
    mx = max_(cnt, mx);
    if (arr[n-2] < arr[n-1]){
        cnt++;
    }
    if (arr[n-2] >= arr[n-1]){
        cnt = 0;
    }
    return pp(arr, n-1);
} // организована рекурсивная функция, что я прохожусь по каждому элементу массива и в процессе этого изменяю счетчик
// причем сохраняю количество возрастющих элементов в подпоследовательности

int main() {
    setlocale(LC_ALL, "Russian");
    int n;
    scanf("%i", &n);
    if (n < 0){
        printf("ERROR: массива с таким количеством элементов не существует");// проверка на корректность количества элементов и существования массива и вывод сооющения так как не указано как нужно обработать ошибки
        return 0;
    }
    if (n < 3 && n > 0){
        printf("В массиве недостаточно элементов, чтобы существовало хотя бы 3 возрастающих");// отсчесение массивов, где количество элементов < 3, так как по условиям задачи необходимо 3 возрастающих элемента
        return 0;
    }
    int arr[n];
    for(int i = 0; i < n; i++){
        scanf("%i", &arr[i]);
    }
    pp(arr, n);// вызов функции
    if (n >= 3){
        if (mx >= 3){
            printf("В данном массиве существует подпоследовательность из 3 возрастающих элементов");// вывод ответа так как в условие задачи не указано, что нужно выводить подпоследовательность, а указано вывести что существует или же нет, поэтому вывод сообщением
        } else {
            printf("В данном массиве не существует подпоследовательности из 3 возрастающих элементов");
        }
        //printf("%i", mx); здесь была организована проверка на количество возрастающих элементов
    }

    return 0;
}
